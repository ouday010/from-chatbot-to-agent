# Copy this file to a new file named ".env" and put your key after the "=".
# No quotes. No spaces. Never share the .env file and never upload it.
OPENROUTER_API_KEY=your-key-here
BASE_URL=https://openrouter.ai/api/v1

# Free models, in the order the program tries them (the first one is tried first).
# If a model fails, the program tries the next one.
# Models that worked best in our tests are first. The "nemotron" reasoning models are last
# because they often return empty answers.
# Free models change often: run "python tools/list_free_models.py --env" to get a fresh line.
MODELS=cohere/north-mini-code:free,liquid/lfm-2.5-2.6b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,liquid/lfm-3-1.7b:free,recursive/flint-v1.0:free,xingchen-agi/xing4.0-29b-a4b:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# How many models to try for ONE question (every try uses 1 of your ~50 free requests per day).
MAX_TRIES=6
# Seconds to wait for one model before trying the next one.
TIMEOUT=30
